(def x 2)
x                   ; => 2
(def big (+ 40 2))
big                 ; => 42
big                 ; => 42
(def (twice-arg y) (+ y y))
(twice-arg (+ 1 2)) ; => 6
(def x2 (+ x2 1))
x2                  ; black-hole error
(def tea (/ 1 0))
tea                 ; ZeroDivisionError
tea                 ; ZeroDivisionError again, once the try fix is in